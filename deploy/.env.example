# astrx-suite — deployment settings. Copy to the SUITE ROOT as `.env`:
#     cp deploy/.env.example .env
#
# Every value here is optional; the defaults run the published stack behind Tor.

# Image tag applied to every built image (astrx/suite:${IMAGE_TAG}, ...).
IMAGE_TAG=latest

# The roles the `serve` container runs (internal network only). Out of:
#   gitweb, onion-search, web-search, torrent-search, dash   (the default)
#   onion-crawl   the darknet crawler (its only way out is Tor's SOCKS port)
#   tracker       the BitTorrent trackers
# e.g.  ASTRX_SERVE_ROLES=gitweb,onion-search,web-search,torrent-search,dash,onion-crawl,tracker
ASTRX_SERVE_ROLES=

# The `crawl` container (egress only) starts only with this profile:
#   COMPOSE_PROFILES=crawl
COMPOSE_PROFILES=
# …and runs these roles, out of: web-crawl (clearnet), dht-index (DHT
# harvester). Default: both.
ASTRX_CRAWL_ROLES=

# gitweb: optional HTTP Basic credential (user:hash). Generate the hash with
#     docker compose run --rm serve gitweb --hash-password
# Leave empty to serve the repositories read-only and unauthenticated.
GITWEB_AUTH=
